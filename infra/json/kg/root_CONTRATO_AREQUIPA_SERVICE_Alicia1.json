  "prohibitions": [
    {
      "id": "prohibition-1",
      "action": "No descontar gastos administrativos",
      "summary": "El Empleador no puede descontar a la Empleada los gastos administrativos de doscientos nuevos soles.",
      "text": "los gastos administrativos que ellos demandan, que equivalen a S/. 200.00 Nuevos Soles por concepto de verificaciones y validación documentaría, que no será descontado a la Empleada en ningún caso.",
      "evidenceVerified": true,
      "evidenceSpans": [
        "los gastos administrativos que ellos demandan, que equivalen a S/. 200.00 Nuevos Soles por concepto de verificaciones y validación documentaría, que no será descontado a la Empleada en ningún caso."
      ],
      "burdenPartyId": "party-1",
      "benefitPartyId": null,
      "clauseId": "clause-2",
      "deadline": "",
      "frequency": "",
