  "conditions": [
    {
      "id": "condition-1",
      "trigger": "En caso la Empleada no llegara a cumplir su mes",
      "operator": "IF",
      "gatesId": "obligation-4",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-11"
      ]
    },
    {
      "id": "condition-2",
      "trigger": "En caso el Empleador quisiera prescindir de los servicio de la Empleada",
      "operator": "IF",
      "gatesId": "obligation-5",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-12"
      ]
    },
    {
      "id": "condition-3",
      "trigger": "previo pago de los 15 días",
      "operator": "UPON",
      "gatesId": "right-1",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-12"
      ]
    },
    {
      "id": "condition-4",
      "trigger": "el despido inmediato",
      "operator": "IF",
      "gatesId": "obligation-6",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-12"
      ]
    },
    {
      "id": "condition-5",
      "trigger": "Si la Empleada hace abandono de trabajo y no avisara con 15 días de anticipación",
      "operator": "IF",
      "gatesId": "obligation-10",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-15"
      ]
    },
    {
      "id": "condition-6",
      "trigger": "el pago de los días de trabajo de la Empleada en la Agencia al momento del reemplazo que efectúe el Cliente",
      "operator": "IF",
      "gatesId": "right-2",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-17"
      ]
    },
    {
      "id": "condition-7",
      "trigger": "Si no se respeta este punto",
      "operator": "IF",
      "gatesId": "right-5",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-17"
      ]
    },
    {
      "id": "condition-8",
      "trigger": "si mediante carta los trabajadores, comuniquen a la Agencia en 2 oportunidades diferentes que no cuentan con las condiciones mínimas para laborar",
      "operator": "IF",
      "gatesId": "right-6",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-18"
      ]
    },
    {
      "id": "condition-9",
      "trigger": "si este ha recibido algún maltrato verbal ó físico",
      "operator": "IF",
      "gatesId": "right-6",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-18"
      ]
    },
    {
      "id": "condition-10",
      "trigger": "Salvo que la empleada trabaje una semana adicional",
      "operator": "UNLESS",
      "gatesId": "obligation-14",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-20"
      ]
    },
    {
      "id": "condition-11",
      "trigger": "por cualquier eventualidad en que la Empleada no este de acuerdo con las costumbres del Cliente",
      "operator": "IF",
      "gatesId": "right-8",
      "paragraphIds": [
        "root::CONTRATO AREQUIPA SERVICE Alicia1-p-21"
      ]
    }
  ],
