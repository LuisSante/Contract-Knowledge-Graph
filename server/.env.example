# ContraVis server — environment template.
# Copy to `server/.env` and fill in the values. Do NOT commit the real `.env`.

# --- LLM providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Timeout (s) y reintentos del cliente LLM (aplican a OpenAI).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- CORS ---
# Orígenes permitidos para el frontend, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Neo4j (knowledge graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Storage paths (relative to server/) ---
SAVED_CONTRADICTIONS_DIR=../infra/contradiction_results
GRAPH_OUTPUT_DIR=../infra/json/graph

# --- Related paragraphs ---
SEMANTIC_RELATED_MODE=top_k

# --- Contradiction analysis tuning ---
CONTRADICTION_TARGET_BATCH_INPUT_TOKENS=35000
CONTRADICTION_HIGH_RECALL=1
CONTRADICTION_NEGATIVE_FLIP_THRESHOLD=45
